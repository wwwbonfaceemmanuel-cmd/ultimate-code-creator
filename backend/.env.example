# ---- AI provider (server-side only; never exposed to the browser) ----
# Any OpenAI-compatible /chat/completions endpoint works
# (OpenAI, OpenRouter, Groq, Together, a local Ollama server, ...).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Model id exactly as your provider names it. Generation stays disabled until set.
AI_MODEL=
AI_TIMEOUT_SECONDS=180
AI_MAX_OUTPUT_TOKENS=8000
# Set to false if your provider rejects the response_format parameter.
AI_JSON_MODE=true

# ---- Supabase: sign-in, project storage and AI usage limits ----
# All three come from your Supabase project's API settings.
# Without them the app runs in single-user local mode: no login, and projects
# are stored as files in LOCAL_DATA_DIR.
SUPABASE_URL=
# Public key (also called "anon" or "publishable"). Safe to expose; turns sign-in on.
SUPABASE_ANON_KEY=
# Secret key (also called "service_role"). Never share it; turns database storage on.
SUPABASE_SERVICE_ROLE_KEY=

# Set to true on any server other people can reach. The API then refuses to
# serve anything until sign-in is configured, instead of running wide open.
REQUIRE_AUTH=false

# ---- AI usage limits (per signed-in user; 0 = no limit) ----
AI_LIMIT_PER_HOUR=20
AI_LIMIT_PER_DAY=100

# ---- App ----
LOCAL_DATA_DIR=./data
# Comma-separated browser origins allowed to call the API (only needed when
# the frontend is hosted on a different origin than the backend).
CORS_ORIGINS=http://localhost:5173
# Directory of the built frontend, served by the backend when it exists.
FRONTEND_DIST=../frontend/dist
