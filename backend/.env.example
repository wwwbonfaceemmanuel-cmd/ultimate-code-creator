# ---- AI provider (server-side only; never exposed to the browser) ----
# Any OpenAI-compatible /chat/completions endpoint works
# (OpenAI, OpenRouter, Groq, Together, a local Ollama server, ...).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Model id exactly as your provider names it. Generation stays disabled until set.
AI_MODEL=
AI_TIMEOUT_SECONDS=180
AI_MAX_OUTPUT_TOKENS=8000
# Set to false if your provider rejects the response_format parameter.
AI_JSON_MODE=true

# ---- Supabase (optional; without it projects are stored in LOCAL_DATA_DIR) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
LOCAL_DATA_DIR=./data
# Comma-separated browser origins allowed to call the API (only needed when
# the frontend is hosted on a different origin than the backend).
CORS_ORIGINS=http://localhost:5173
# Directory of the built frontend, served by the backend when it exists.
FRONTEND_DIST=../frontend/dist
